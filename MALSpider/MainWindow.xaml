<Window x:Class="MALSpider.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MALSpider"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Background="#121212" Foreground="#E0E0E0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="10" Grid.Row="0">
            <TextBlock Text="Search or URL:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#E0E0E0"/>
            <ComboBox x:Name="SearchBox" Width="500" Margin="0,0,5,0" IsEditable="True" KeyDown="SearchBox_KeyDown"
                      VerticalContentAlignment="Center" Padding="5,0">
                <ComboBox.Resources>
                    <Style TargetType="TextBox">
                        <Setter Property="Background" Value="#1E1E1E"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="CaretBrush" Value="White"/>
                    </Style>
                </ComboBox.Resources>
            </ComboBox>
            <Button Content="Spider" Click="Spider_Click" Padding="15,5" Background="#3700B3" Foreground="White" BorderThickness="0"/>
        </StackPanel>

        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      MouseDown="ScrollViewer_MouseDown" MouseMove="ScrollViewer_MouseMove" MouseUp="ScrollViewer_MouseUp">
            <Canvas x:Name="GraphCanvas" Background="#121212" MouseDown="GraphCanvas_MouseDown"/>
        </ScrollViewer>

        <StatusBar Grid.Row="2" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="0,1,0,0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0">
                <TextBlock x:Name="StatusLabel" Foreground="#BB86FC" TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1">
                <ProgressBar x:Name="WorkProgressBar" Width="200" Height="16" Visibility="Collapsed" Minimum="0" Maximum="100"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
